---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Not found" description="That page doesn't exist.">
	<section class="container notfound">
		<p class="code" aria-hidden="true">404</p>
		<p class="kicker">Page not found</p>
		<h1>This square is empty.</h1>
		<p class="lead">The page may have moved, or the link may be wrong.</p>
		<a class="btn btn-primary" href="/"><Icon name="arrow-left" /> Back home</a>
	</section>
</BaseLayout>

<style>
	.notfound {
		display: grid;
		justify-items: start;
		gap: 1rem;
		padding-block: clamp(4rem, 14vw, 9rem);
	}

	.code {
		background: var(--gradient);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		font-family: var(--font-mono);
		font-size: clamp(4.5rem, 3rem + 8vw, 9rem);
		font-weight: 500;
		letter-spacing: -0.06em;
		line-height: 0.9;
	}

	h1 {
		font-family: var(--font-display);
		font-size: var(--step-3);
		font-weight: 400;
	}

	.lead {
		margin-block-end: 1rem;
		color: var(--muted);
		font-size: var(--step-1);
	}
</style>
