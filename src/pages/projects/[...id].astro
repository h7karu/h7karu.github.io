---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ProjectArt from '../../components/ProjectArt.astro';

export const getStaticPaths = (async () => {
	const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
	return projects.map((project, i) => ({
		params: { id: project.id },
		props: { project, next: projects[(i + 1) % projects.length] },
	}));
}) satisfies GetStaticPaths;

const { project, next } = Astro.props;
const { title, summary, year, context, team, role, metrics, tags, repo, url, art } = project.data;
const { Content } = await render(project);
---

<BaseLayout title={title} description={summary}>
	<article class="case">
		<header class="container narrow head">
			<a class="back" href="/projects/"><Icon name="arrow-left" /> All projects</a>

			<p class="kicker reveal">{context} · {year}</p>
			<h1 class="reveal" style="--reveal-delay: 60ms">{title}</h1>
			<p class="lead reveal" style="--reveal-delay: 120ms">{summary}</p>

			<dl class="facts reveal" style="--reveal-delay: 160ms">
				{
					team && (
						<div>
							<dt>Team</dt>
							<dd>{team}</dd>
						</div>
					)
				}
				{
					role && (
						<div>
							<dt>My role</dt>
							<dd>{role}</dd>
						</div>
					)
				}
				<div>
					<dt>Stack</dt>
					<dd>{tags.join(' · ')}</dd>
				</div>
			</dl>

			{
				(repo || url) && (
					<div class="actions reveal" style="--reveal-delay: 200ms">
						{repo && (
							<a class="btn btn-primary" href={repo} target="_blank" rel="noopener">
								<Icon name="github" /> View the code
							</a>
						)}
						{url && (
							<a class="btn btn-secondary" href={url} target="_blank" rel="noopener">
								Live demo <Icon name="arrow-up-right" />
							</a>
						)}
					</div>
				)
			}
		</header>

		<div class="container">
			<div class="banner card reveal">
				<div class="banner-art">
					<ProjectArt kind={art} />
				</div>
				{
					metrics.length > 0 && (
						<dl class="banner-metrics">
							{metrics.map((metric) => (
								<div>
									<dt>{metric.label}</dt>
									<dd>{metric.value}</dd>
								</div>
							))}
						</dl>
					)
				}
			</div>
		</div>

		<div class="container narrow">
			<div class="prose body">
				<Content />
			</div>
		</div>

		<nav class="container narrow next-wrap" aria-label="More projects">
			<a class="next card" href={`/projects/${next.id}/`}>
				<span class="next-label">Next project</span>
				<span class="next-title">{next.data.title}</span>
				<span class="next-arrow"><Icon name="arrow-right" /></span>
			</a>
		</nav>
	</article>
</BaseLayout>

<style>
	.narrow {
		max-width: calc(48rem + 2 * var(--gutter));
	}

	.head {
		padding-block: clamp(2rem, 6vw, 4rem) clamp(2rem, 5vw, 3rem);
	}

	.back {
		display: flex;
		width: fit-content;
		align-items: center;
		gap: 0.45rem;
		margin-block-end: 2.25rem;
		color: var(--muted);
		font-size: var(--step--1);
		text-decoration: none;
	}

	.back:hover {
		color: var(--accent);
	}

	h1 {
		margin-block: 0.9rem 1rem;
		font-family: var(--font-display);
		font-size: var(--step-4);
		font-weight: 400;
		line-height: 1;
		letter-spacing: -0.02em;
	}

	.lead {
		color: var(--muted);
		font-size: var(--step-1);
		line-height: 1.55;
	}

	.facts {
		display: grid;
		gap: 0.75rem;
		margin: 2rem 0 0;
		padding: 1.25rem 0;
		border-block: 1px solid var(--line);
	}

	.facts div {
		display: grid;
		grid-template-columns: 6.5rem minmax(0, 1fr);
		gap: 1rem;
	}

	.facts dt {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: var(--step--2);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		line-height: 2;
	}

	.facts dd {
		margin: 0;
		color: var(--ink);
		font-size: var(--step--1);
		line-height: 1.6;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-block-start: 1.75rem;
	}

	/* ── Banner: illustration + headline numbers ── */

	.banner {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
		max-width: 64rem;
		margin-inline: auto;
		overflow: hidden;
		box-shadow: var(--shadow);
	}

	.banner-art {
		display: grid;
		place-items: center;
		padding: clamp(1.25rem, 4vw, 2.5rem);
		border-inline-end: 1px solid var(--line);
		background: linear-gradient(150deg, #eef4ff 0%, #f3f7fd 50%, #e5f6fb 100%);
	}

	.banner-art :global(.art-svg) {
		max-width: 28rem;
	}

	.banner-metrics {
		display: grid;
		align-content: center;
		margin: 0;
	}

	.banner-metrics div {
		display: flex;
		flex-direction: column-reverse;
		gap: 0.25rem;
		padding: 1.3rem clamp(1.25rem, 3vw, 2rem);
	}

	.banner-metrics div + div {
		border-top: 1px solid var(--line);
	}

	.banner-metrics dd {
		margin: 0;
		color: var(--ink);
		font-family: var(--font-mono);
		font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.1rem);
		font-weight: 500;
		letter-spacing: -0.04em;
		line-height: 1.1;
	}

	.banner-metrics dt {
		color: var(--muted);
		font-size: var(--step--1);
	}

	.body {
		padding-block: clamp(1rem, 3vw, 2rem) clamp(2.5rem, 6vw, 4rem);
	}

	/* ── Next project ── */

	.next-wrap {
		padding-block-end: clamp(3rem, 8vw, 5rem);
	}

	.next {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.3rem 1.5rem;
		padding: clamp(1.25rem, 3vw, 1.75rem) clamp(1.25rem, 3vw, 2rem);
		text-decoration: none;
		transition:
			border-color 0.25s ease,
			box-shadow 0.25s ease,
			transform 0.3s var(--ease);
	}

	.next:hover {
		border-color: var(--accent-line);
		box-shadow: var(--shadow);
		color: inherit;
		transform: translateY(-2px);
	}

	.next-label {
		grid-column: 1;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: var(--step--2);
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.next-title {
		grid-column: 1;
		color: var(--ink);
		font-family: var(--font-display);
		font-size: var(--step-2);
		line-height: 1.15;
	}

	.next-arrow {
		display: grid;
		grid-row: 1 / span 2;
		grid-column: 2;
		place-items: center;
		width: 2.8rem;
		height: 2.8rem;
		border-radius: 999px;
		background: var(--accent-soft);
		color: var(--accent);
		transition: transform 0.3s var(--ease);
	}

	.next:hover .next-arrow {
		transform: translateX(3px);
	}

	@media (max-width: 52rem) {
		.banner {
			grid-template-columns: minmax(0, 1fr);
		}

		.banner-art {
			border-inline-end: 0;
			border-bottom: 1px solid var(--line);
		}

		.banner-metrics {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.banner-metrics div + div {
			border-top: 0;
			border-inline-start: 1px solid var(--line);
		}

		.banner-metrics div {
			padding: 1.1rem;
		}
	}

	@media (max-width: 34rem) {
		.banner-metrics {
			grid-template-columns: minmax(0, 1fr);
		}

		.banner-metrics div + div {
			border-inline-start: 0;
			border-top: 1px solid var(--line);
		}

		.facts div {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.1rem;
		}
	}
</style>
