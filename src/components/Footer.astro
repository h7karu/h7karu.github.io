---
import Icon from './Icon.astro';
import { SITE } from '../site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container inner">
		<div class="sign">
			<span class="mark" aria-hidden="true">{SITE.initials}</span>
			<p>{`© ${year} ${SITE.name}. Built with Astro, hosted on GitHub Pages.`}</p>
		</div>
		<ul class="links">
			<li>
				<a href={SITE.github} rel="me noopener" target="_blank">
					<Icon name="github" /> GitHub
				</a>
			</li>
			<li>
				<a href={SITE.linkedin} rel="me noopener" target="_blank">
					<Icon name="linkedin" /> LinkedIn
				</a>
			</li>
			<li>
				<a href={`mailto:${SITE.email}`}><Icon name="mail" /> Email</a>
			</li>
		</ul>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--line);
		background: rgb(255 255 255 / 0.55);
	}

	.inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 2rem;
		padding-block: 1.75rem calc(1.75rem + env(safe-area-inset-bottom, 0px));
	}

	.sign {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		color: var(--muted);
		font-size: var(--step--1);
	}

	.mark {
		display: grid;
		flex: none;
		place-items: center;
		width: 1.75rem;
		height: 1.75rem;
		border-radius: 8px;
		background: var(--gradient);
		color: #fff;
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.04em;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: var(--step--1);
	}

	.links a {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		color: var(--muted);
		text-decoration: none;
	}

	.links a:hover {
		color: var(--accent);
	}
</style>
