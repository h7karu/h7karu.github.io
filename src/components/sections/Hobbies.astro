---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { CHESS, CUBE_PB, SPORTS, TABLETOP } from '../../data/profile';
import chessPhoto from '../../assets/hikaru-chess.jpg';
import cubePhoto from '../../assets/cube-pb.jpg';
---

<div class="hobbies">
	<article class="tile photo-tile chess card reveal">
		<figure class="photo">
			<Image
				src={chessPhoto}
				alt="Kawaguchi Hikaru, chin in hand, studying a chessboard at the NUS Inter-College Games"
				widths={[400, 560, 712]}
				sizes="(min-width: 72rem) 35rem, (min-width: 38rem) 46vw, 92vw"
				loading="eager"
			/>
			<figcaption class="caption"><Icon name="pin" /> NUS Inter-College Games</figcaption>
		</figure>
		<div class="tile-body">
			<div class="tile-head">
				<span class="t-icon"><Icon name="knight" /></span>
				<h2>Chess</h2>
			</div>
			<dl class="ratings">
				<div>
					<dt>Rapid</dt>
					<dd>{CHESS.rapid}</dd>
				</div>
				<div>
					<dt>Blitz</dt>
					<dd>{CHESS.blitz}</dd>
				</div>
			</dl>
			<p class="note">Peak ratings on Chess.com</p>
			<p class="text">
				I've played for my college at the NUS Inter-College Games. My favourite players are
				Abdusattorov, Carlsen and Nakamura — enough that I{' '}
				<a href="/projects/chess-gm-classifier/">trained a CNN to recognise them</a>.
			</p>
		</div>
	</article>

	<article class="tile photo-tile cube card reveal" style="--reveal-delay: 90ms">
		<figure class="photo">
			<Image
				src={cubePhoto}
				alt="A speedcubing timer reading 9.97 seconds beside a 3×3 Rubik's cube"
				widths={[400, 560, 800]}
				sizes="(min-width: 72rem) 35rem, (min-width: 38rem) 46vw, 92vw"
				loading="eager"
			/>
			<figcaption class="caption"><Icon name="cube" /> Personal best</figcaption>
		</figure>
		<div class="tile-body">
			<div class="tile-head">
				<span class="t-icon"><Icon name="cube" /></span>
				<h2>Speedcubing</h2>
			</div>
			<p class="big">{CUBE_PB.seconds}<small>s</small></p>
			<p class="note">{CUBE_PB.event} personal best, single solve</p>
			<p class="text">My fastest solve on the 3×3 so far.</p>
		</div>
	</article>

	<article class="tile poker card reveal">
		<div class="tile-head">
			<span class="t-icon"><Icon name="spade" /></span>
			<h2>Poker</h2>
		</div>
		<p class="big"><small>S$</small>15k+</p>
		<p class="text">
			In profit at low stakes. I study poker strategy — expected value, variance and decisions on
			incomplete information.
		</p>
	</article>

	<article class="tile sport card reveal" style="--reveal-delay: 90ms">
		<div class="tile-head">
			<span class="t-icon"><Icon name="paddle" /></span>
			<h2>Sport</h2>
		</div>
		<p class="text">
			I captained the table tennis team at Temasek Junior College. I also really enjoy bouldering, pickleball, basketball and soccer.
		</p>
		<ul class="chips">
			{SPORTS.map((sport, i) => <li class:list={['chip', { 'chip--accent': i === 0 }]}>{sport}</li>)}
		</ul>
	</article>

	<article class="tile tabletop card reveal">
		<div class="tile-head">
			<span class="t-icon"><Icon name="dice" /></span>
			<h2>Bridge &amp; board games</h2>
		</div>
		<p class="text">
			Strategy games of every kind, from floating bridge to a loud round of Codenames.
		</p>
		<ul class="chips">
			{TABLETOP.map((game) => <li class="chip">{game}</li>)}
		</ul>
	</article>

	<article class="tile reading card reveal" style="--reveal-delay: 90ms">
		<div class="tile-head">
			<span class="t-icon"><Icon name="book" /></span>
			<h2>Reading</h2>
		</div>
		<p class="text">When I'm not playing something, I'm usually reading.</p>
		<div class="shelf" aria-hidden="true">
			<span></span><span></span><span></span><span></span><span></span><span></span><span></span>
		</div>
	</article>
</div>

<style>
	.hobbies {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem;
	}

	.tile {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		padding: clamp(1.3rem, 3vw, 1.75rem);
		overflow: hidden;
		transition:
			border-color 0.3s ease,
			box-shadow 0.3s ease;
	}

	.tile:hover {
		border-color: var(--accent-line);
		box-shadow: var(--shadow);
	}

	.tile-head {
		display: flex;
		align-items: center;
		gap: 0.7rem;
	}

	.t-icon {
		display: grid;
		flex: none;
		place-items: center;
		width: 2.3rem;
		height: 2.3rem;
		border-radius: 11px;
		background: var(--accent-soft);
		color: var(--accent);
	}

	.t-icon :global(.icon) {
		width: 1.2rem;
		height: 1.2rem;
	}

	h2 {
		font-size: var(--step-1);
	}

	.text {
		color: var(--muted);
		font-size: var(--step--1);
		line-height: 1.6;
	}

	.text a {
		color: var(--accent);
	}

	.note {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: var(--step--2);
		letter-spacing: 0.02em;
	}

	.big {
		color: var(--ink);
		font-size: clamp(2.2rem, 1.8rem + 1.6vw, 3rem);
		font-weight: 600;
		letter-spacing: -0.045em;
		line-height: 1;
	}

	.big small {
		margin-inline: 0.15rem;
		color: var(--muted);
		font-size: 0.45em;
		letter-spacing: 0;
	}

	/* ── Photo tiles: chess and cubing ── */

	.photo-tile {
		padding: 0;
	}

	.photo {
		position: relative;
		aspect-ratio: 5 / 4;
		margin: 0;
		overflow: hidden;
		background: #dde6f2;
	}

	.photo :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.8s var(--ease);
	}

	.photo-tile:hover .photo :global(img) {
		transform: scale(1.03);
	}

	/* Keep both the face and the board in frame. */
	.chess .photo :global(img) {
		object-position: 50% 80%;
	}

	.cube .photo :global(img) {
		object-position: 50% 45%;
	}

	.caption {
		position: absolute;
		top: 1rem;
		left: 1rem;
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.45rem 0.8rem;
		border: 1px solid rgb(255 255 255 / 0.9);
		border-radius: 12px;
		background: rgb(255 255 255 / 0.85);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		box-shadow: var(--shadow);
		color: var(--ink);
		font-size: var(--step--2);
		font-weight: 500;
	}

	.caption :global(.icon) {
		color: var(--accent);
	}

	.tile-body {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		padding: clamp(1.3rem, 3vw, 1.75rem);
	}

	.ratings {
		display: flex;
		gap: 2.5rem;
		margin: 0.25rem 0 0;
	}

	.ratings div {
		display: flex;
		flex-direction: column-reverse;
	}

	.ratings dd {
		margin: 0;
		background: var(--gradient);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		font-family: var(--font-mono);
		font-size: clamp(2.2rem, 1.9rem + 1.4vw, 3rem);
		font-weight: 500;
		letter-spacing: -0.05em;
		line-height: 1;
	}

	.ratings dt {
		margin-block-start: 0.35rem;
		color: var(--ink);
		font-size: var(--step--1);
		font-weight: 600;
	}

	/* ── Tabletop & sport ── */

	.tabletop .chips,
	.sport .chips {
		margin-block-start: auto;
		padding-block-start: 0.25rem;
	}

	/* ── Reading: a little bookshelf ── */

	.shelf {
		display: flex;
		align-items: flex-end;
		align-self: flex-end;
		gap: 4px;
		height: 4.75rem;
		margin-block-start: auto;
		padding-inline: 0.5rem;
		border-bottom: 2px solid var(--line-strong);
	}

	.shelf span {
		width: 13px;
		border-radius: 3px 3px 1px 1px;
		background: var(--c);
	}

	.shelf span:nth-child(1) { --c: #2459e0; height: 82%; }
	.shelf span:nth-child(2) { --c: #9fb8ee; height: 64%; width: 10px; }
	.shelf span:nth-child(3) { --c: #0b9cc0; height: 92%; }
	.shelf span:nth-child(4) { --c: #0b1628; height: 72%; width: 16px; }
	.shelf span:nth-child(5) { --c: #c8d8fb; height: 86%; }
	.shelf span:nth-child(6) { --c: #1d87e4; height: 58%; width: 11px; }

	/* The last one leans on its neighbour. */
	.shelf span:nth-child(7) {
		--c: #aee6f2;
		height: 76%;
		transform: rotate(-12deg);
		transform-origin: bottom right;
		margin-inline-start: 6px;
	}

	@media (max-width: 38rem) {
		.hobbies {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
