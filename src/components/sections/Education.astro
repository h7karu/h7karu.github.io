---
import Icon from '../Icon.astro';
import { COURSEWORK, EDUCATION } from '../../data/profile';
---

<div class="schools">
	{
		EDUCATION.map((school, i) => (
			<article class="school card reveal" style={`--reveal-delay: ${i * 90}ms`}>
				<header class="school-head">
					<div>
						<h2>{school.school}</h2>
						<p class="degree">{school.degree}</p>
						<p class="period">{school.period}</p>
					</div>
					<p class="score">
						<span class="score-value">{school.score.value}</span>
						<span class="score-label">{school.score.label}</span>
					</p>
				</header>
				<ul class="honours">
					{school.honours.map((honour) => (
						<li>
							<span class="honour-icon">
								<Icon name={honour.icon} />
							</span>
							{honour.text}
						</li>
					))}
				</ul>
			</article>
		))
	}
</div>

<div class="coursework card reveal">
	<header class="cw-head">
		<h2>Selected coursework</h2>
		<p>Grades from my NUS transcript.</p>
	</header>
	<div class="cw-grid">
		{
			COURSEWORK.map((area) => (
				<div class="cw-area">
					<p class="cw-name">{area.area}</p>
					<ul>
						{area.courses.map((course) => (
							<li>
								<span class="code">{course.code}</span>
								<span class="title">{course.title}</span>
								<span class:list={['grade', { 'grade-top': course.grade === 'A+' }]}>
									{course.grade}
								</span>
							</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
</div>

<style>
	.schools {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
		gap: 1.25rem;
	}

	.school {
		padding: clamp(1.4rem, 3vw, 2rem);
	}

	.school-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1.25rem;
		padding-block-end: 1.25rem;
		border-bottom: 1px solid var(--line);
	}

	h2 {
		font-size: var(--step-1);
	}

	.degree {
		margin-block-start: 0.35rem;
		color: var(--text);
		font-weight: 500;
	}

	.period {
		margin-block-start: 0.2rem;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: var(--step--2);
	}

	.score {
		display: grid;
		flex: none;
		justify-items: center;
		min-width: 6.5rem;
		padding: 0.75rem 0.9rem;
		border: 1px solid var(--accent-line);
		border-radius: var(--radius);
		background: linear-gradient(160deg, var(--accent-soft), var(--cyan-soft));
		text-align: center;
	}

	.score-value {
		background: var(--gradient);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		font-family: var(--font-mono);
		font-size: 1.6rem;
		font-weight: 500;
		letter-spacing: -0.04em;
		line-height: 1.15;
	}

	.score-label {
		color: var(--muted);
		font-size: 0.7rem;
		line-height: 1.3;
	}

	.honours {
		display: grid;
		gap: 0.7rem;
		margin: 1.25rem 0 0;
		padding: 0;
		list-style: none;
	}

	.honours li {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		color: var(--text);
		font-size: var(--step--1);
		line-height: 1.45;
	}

	.honour-icon {
		display: grid;
		flex: none;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border-radius: 9px;
		background: var(--accent-soft);
		color: var(--accent);
	}

	.honour-icon :global(.icon) {
		width: 1.05rem;
		height: 1.05rem;
	}

	/* ── Coursework ── */

	.coursework {
		margin-block-start: 1.25rem;
		padding: clamp(1.4rem, 3vw, 2rem);
	}

	.cw-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		margin-block-end: 1.5rem;
	}

	.cw-head p {
		color: var(--muted);
		font-size: var(--step--1);
	}

	.cw-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.5rem 2rem;
	}

	.cw-name {
		margin-block-end: 0.5rem;
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: var(--step--2);
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.cw-area ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.cw-area li {
		display: grid;
		grid-template-columns: 4.6rem minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.75rem;
		padding-block: 0.55rem;
		border-bottom: 1px dashed var(--line);
		font-size: var(--step--1);
	}

	.cw-area li:last-child {
		border-bottom: 0;
	}

	.code {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: var(--step--2);
	}

	.title {
		color: var(--ink);
		line-height: 1.35;
	}

	.grade {
		min-width: 2.2rem;
		padding: 0.1rem 0.45rem;
		border: 1px solid var(--line);
		border-radius: 6px;
		background: var(--surface-muted);
		color: var(--text);
		font-family: var(--font-mono);
		font-size: var(--step--2);
		font-weight: 500;
		text-align: center;
	}

	.grade-top {
		border-color: var(--accent-line);
		background: var(--accent-soft);
		color: var(--accent-hover);
	}

	@media (max-width: 60rem) {
		.schools,
		.cw-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (max-width: 30rem) {
		.school-head {
			flex-direction: column;
		}

		.score {
			justify-items: start;
			grid-auto-flow: column;
			align-items: baseline;
			gap: 0.6rem;
			min-width: 0;
			text-align: start;
		}
	}
</style>
