---
import Icon from '../Icon.astro';
import { SITE } from '../../site';
---

<div class="contact card reveal">
	<div class="copy">
		<p class="kicker">Contact</p>
		<h1 class="section-title">Let's <em>talk</em>.</h1>
		<p class="section-intro">
			I'm always happy to talk about data science, machine learning, quantitative trading — or a
			good game of chess. Email is the fastest way to reach me.
		</p>
	</div>

	<div class="reach">
		<div class="email-row">
			<a class="email" href={`mailto:${SITE.email}`}>{SITE.email}</a>
			<button class="copy-btn" type="button" data-copy={SITE.email}>
				<Icon name="copy" class="i-copy" />
				<Icon name="check" class="i-check" />
				<span class="sr-only">Copy email address</span>
			</button>
			<span class="copy-status" role="status" aria-live="polite"></span>
		</div>

		<div class="buttons">
			<a class="btn btn-primary" href={`mailto:${SITE.email}`}>
				<Icon name="mail" /> Email me
			</a>
			<a class="btn btn-secondary" href={SITE.linkedin} target="_blank" rel="me noopener">
				<Icon name="linkedin" /> LinkedIn
			</a>
			<a class="btn btn-secondary" href={SITE.github} target="_blank" rel="me noopener">
				<Icon name="github" /> GitHub
			</a>
		</div>

		<p class="where"><Icon name="pin" /> Based in {SITE.location}</p>
	</div>
</div>

<style>
	.contact {
		position: relative;
		isolation: isolate;
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
		align-items: center;
		gap: clamp(2rem, 5vw, 4rem);
		padding: clamp(1.75rem, 5vw, 3.5rem);
		overflow: hidden;
		border: 1px solid transparent;
		background:
			linear-gradient(var(--surface), var(--surface)) padding-box,
			linear-gradient(135deg, #b7ccf8, #e1e8f1 45%, #aee6f2) border-box;
		box-shadow: var(--shadow-lg);
	}

	/* Glow and graph paper in the corner. */
	.contact::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			radial-gradient(28rem 18rem at 100% 0%, rgb(11 179 209 / 0.12), transparent 70%),
			radial-gradient(30rem 20rem at 0% 100%, rgb(36 89 224 / 0.1), transparent 70%);
	}

	.contact::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background-image:
			linear-gradient(rgb(36 89 224 / 0.06) 1px, transparent 1px),
			linear-gradient(90deg, rgb(36 89 224 / 0.06) 1px, transparent 1px);
		background-size: 28px 28px;
		mask-image: radial-gradient(circle at 100% 0%, #000, transparent 55%);
		-webkit-mask-image: radial-gradient(circle at 100% 0%, #000, transparent 55%);
	}

	.section-title {
		font-size: var(--step-4);
		line-height: 0.95;
	}

	.reach {
		display: grid;
		gap: 1.25rem;
	}

	.email-row {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 0.5rem 0.5rem 1.1rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface-muted);
	}

	.email {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		color: var(--ink);
		font-family: var(--font-mono);
		font-size: clamp(0.85rem, 0.8rem + 0.3vw, 1rem);
		text-decoration: none;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.copy-btn {
		display: grid;
		flex: none;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		padding: 0;
		border: 1px solid var(--line);
		border-radius: 10px;
		background: var(--surface);
		color: var(--muted);
		cursor: pointer;
		transition:
			color 0.18s ease,
			border-color 0.18s ease;
	}

	.copy-btn:hover {
		border-color: var(--accent-line);
		color: var(--accent);
	}

	.copy-btn :global(.icon) {
		grid-area: 1 / 1;
		width: 1.05rem;
		height: 1.05rem;
		transition:
			opacity 0.2s ease,
			transform 0.3s var(--ease);
	}

	.copy-btn :global(.i-check) {
		opacity: 0;
		transform: scale(0.5);
		color: var(--accent);
	}

	.copy-btn[data-copied] :global(.i-copy) {
		opacity: 0;
		transform: scale(0.5);
	}

	.copy-btn[data-copied] :global(.i-check) {
		opacity: 1;
		transform: none;
	}

	.copy-status {
		position: absolute;
		right: 0;
		bottom: calc(100% + 0.4rem);
		padding: 0.2rem 0.55rem;
		border-radius: 6px;
		background: var(--ink);
		color: #fff;
		font-size: var(--step--2);
		opacity: 0;
		transform: translateY(4px);
		transition:
			opacity 0.2s ease,
			transform 0.2s var(--ease);
		pointer-events: none;
	}

	.copy-status:not(:empty) {
		opacity: 1;
		transform: none;
	}

	.buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}

	.where {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--muted);
		font-size: var(--step--1);
	}

	@media (max-width: 56rem) {
		.contact {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>

<script>
	const button = document.querySelector<HTMLButtonElement>('.copy-btn[data-copy]');
	const status = document.querySelector<HTMLElement>('.copy-status');
	let timer: number | undefined;

	button?.addEventListener('click', async () => {
		const text = button.dataset.copy ?? '';
		try {
			await navigator.clipboard.writeText(text);
			button.setAttribute('data-copied', '');
			if (status) status.textContent = 'Copied!';
		} catch {
			// Clipboard blocked (e.g. insecure context) — fall back to the mail link.
			if (status) status.textContent = 'Press ⌘/Ctrl + C';
			window.getSelection()?.selectAllChildren(button.previousElementSibling ?? button);
		}
		window.clearTimeout(timer);
		timer = window.setTimeout(() => {
			button.removeAttribute('data-copied');
			if (status) status.textContent = '';
		}, 1800);
	});
</script>
