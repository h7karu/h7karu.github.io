---
import { getCollection, render } from 'astro:content';
import Icon from '../Icon.astro';
import { formatDuration, formatRange, isoDate } from '../../lib/date';

const entries = (await getCollection('experience')).sort(
	(a, b) => b.data.start.valueOf() - a.data.start.valueOf(),
);

// Render each markdown body once, up front, so the template stays flat.
const roles = await Promise.all(
	entries.map(async (entry) => ({
		entry,
		Content: (await render(entry)).Content,
	})),
);
---

<ol class="timeline">
	{
		roles.map(({ entry, Content }, i) => (
			<li class="role reveal" style={`--reveal-delay: ${i * 90}ms`}>
				<span class="node" aria-hidden="true" />
				<article class="role-card card">
					<header class="role-head">
						<div>
							<h2>{entry.data.role}</h2>
							<p class="org">
								{entry.data.orgUrl ? (
									<a href={entry.data.orgUrl} target="_blank" rel="noopener">
										{entry.data.org}
										<Icon name="arrow-up-right" />
									</a>
								) : (
									<span>{entry.data.org}</span>
								)}
								{entry.data.orgBlurb && <span class="blurb">{entry.data.orgBlurb}</span>}
							</p>
						</div>
						<p class="when">
							<time datetime={isoDate(entry.data.start)}>
								{formatRange(entry.data.start, entry.data.end)}
							</time>
							<span class="duration">{formatDuration(entry.data.start, entry.data.end)}</span>
						</p>
					</header>

					<div class="prose points">
						<Content />
					</div>

					{entry.data.tags.length > 0 && (
						<ul class="chips">
							{entry.data.tags.map((tag) => (
								<li class="chip">{tag}</li>
							))}
						</ul>
					)}
				</article>
			</li>
		))
	}
</ol>

<style>
	.timeline {
		position: relative;
		display: grid;
		gap: 1.25rem;
		margin: 0;
		padding: 0 0 0 2.25rem;
		list-style: none;
	}

	/* The rail. */
	.timeline::before {
		content: '';
		position: absolute;
		top: 1.9rem;
		bottom: 1.9rem;
		left: 0.45rem;
		width: 2px;
		border-radius: 2px;
		background: linear-gradient(var(--accent-line), var(--line));
	}

	.role {
		position: relative;
	}

	.node {
		position: absolute;
		top: 1.95rem;
		left: -2.25rem;
		width: 1.05rem;
		height: 1.05rem;
		border: 3px solid var(--bg);
		border-radius: 50%;
		background: var(--gradient);
		box-shadow: 0 0 0 1px var(--accent-line);
	}

	.role-card {
		padding: clamp(1.35rem, 3vw, 2rem);
		transition:
			border-color 0.25s ease,
			box-shadow 0.25s ease;
	}

	.role-card:hover {
		border-color: var(--accent-line);
		box-shadow: var(--shadow);
	}

	.role-head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.75rem 2rem;
	}

	h2 {
		font-size: var(--step-1);
	}

	.org {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem 0.75rem;
		margin-block-start: 0.35rem;
	}

	.org a,
	.org > span:first-child {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		color: var(--accent);
		font-weight: 600;
		text-decoration: none;
	}

	.org a :global(.icon) {
		width: 0.9em;
		height: 0.9em;
		opacity: 0.7;
	}

	.blurb {
		color: var(--muted);
		font-size: var(--step--1);
	}

	.when {
		display: grid;
		justify-items: end;
		gap: 0.15rem;
		color: var(--ink);
		font-family: var(--font-mono);
		font-size: var(--step--1);
		white-space: nowrap;
	}

	.duration {
		color: var(--muted);
		font-size: var(--step--2);
	}

	.points {
		margin-block: 1.15rem 1.35rem;
		max-width: 60rem;
	}

	.points :global(ul) {
		display: grid;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.points :global(li) {
		position: relative;
		margin: 0;
		padding-inline-start: 1.4rem;
	}

	.points :global(li)::before {
		content: '';
		position: absolute;
		top: 0.72em;
		left: 0.2rem;
		width: 0.45rem;
		height: 2px;
		border-radius: 2px;
		background: var(--accent);
	}

	@media (max-width: 40rem) {
		.timeline {
			padding-inline-start: 1.5rem;
		}

		.timeline::before {
			left: 0.2rem;
		}

		.node {
			left: -1.5rem;
			width: 0.95rem;
			height: 0.95rem;
		}

		.when {
			justify-items: start;
			grid-auto-flow: column;
			gap: 0.75rem;
		}
	}
</style>
