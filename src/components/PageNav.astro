---
import Icon from './Icon.astro';
import { PAGES } from '../site';

interface Props {
	/** The current page's href, e.g. "/experience/". */
	current: string;
}

const { current } = Astro.props;
const index = PAGES.findIndex((page) => page.href === current);
const prev = index > 0 ? PAGES[index - 1] : undefined;
const next = index >= 0 && index < PAGES.length - 1 ? PAGES[index + 1] : undefined;
---

<nav class="container page-nav" aria-label="Previous and next page">
	{
		prev ? (
			<a class="step card prev" href={prev.href}>
				<span class="label">
					<Icon name="arrow-left" /> Previous
				</span>
				<span class="title">{prev.label}</span>
			</a>
		) : (
			<span />
		)
	}
	{
		next && (
			<a class="step card next" href={next.href}>
				<span class="label">
					Next <Icon name="arrow-right" />
				</span>
				<span class="title">{next.label}</span>
			</a>
		)
	}
</nav>

<style>
	.page-nav {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		padding-block: clamp(3rem, 7vw, 5rem) clamp(3.5rem, 8vw, 5.5rem);
	}

	.step {
		display: grid;
		gap: 0.35rem;
		padding: 1.2rem 1.4rem;
		text-decoration: none;
		transition:
			border-color 0.25s ease,
			box-shadow 0.25s ease,
			transform 0.3s var(--ease);
	}

	.step:hover {
		border-color: var(--accent-line);
		box-shadow: var(--shadow);
		color: inherit;
		transform: translateY(-2px);
	}

	.next {
		grid-column: 2;
		text-align: end;
		justify-items: end;
	}

	.label {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: var(--step--2);
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.title {
		color: var(--ink);
		font-family: var(--font-display);
		font-size: var(--step-2);
		line-height: 1.1;
	}

	.step:hover .title {
		color: var(--accent);
	}
</style>
